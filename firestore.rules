rules_version = '2';
// Secret Santa: the list of names already played, one list per draw.
// Anyone may read the list and add a name once; nobody can change or delete
// an entry from the site (the organizer can still delete entries in the
// Firebase console).
service cloud.firestore {
  match /databases/{database}/documents {
    match /draws/{draw}/played/{who} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'at'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && who.size() <= 40;
      allow update, delete: if false;
    }
  }
}
